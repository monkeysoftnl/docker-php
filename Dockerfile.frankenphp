FROM dunglas/frankenphp:php8.5-alpine

# Align www-data with Debian/Ubuntu (33:33); Alpine default is 82:82 and 33 is taken by xfs
RUN deluser www-data \
  && (deluser xfs || true) \
  && (delgroup xfs || true) \
  && addgroup -g 33 -S www-data \
  && adduser -u 33 -S -D -h /var/www -s /sbin/nologin -G www-data www-data

COPY ./.docker/frankenphp/Caddyfile /etc/frankenphp/Caddyfile
COPY ./.docker/php/local.ini /usr/local/etc/php/conf.d/local.ini

COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

RUN apk add --no-cache tree nano unzip curl ca-certificates nodejs npm postgresql-client libcap

RUN install-php-extensions pdo_mysql mysqli zip exif gd bcmath intl pdo_pgsql pgsql pcntl redis imagick opcache

# Allow running as non-root on port 80
RUN setcap cap_net_bind_service=+ep /usr/local/bin/frankenphp \
  && mkdir -p /var/www/html/public \
  && chown -R www-data:www-data /data/caddy /config/caddy /var/www

WORKDIR /var/www/html

EXPOSE 80

# Set Default User
USER www-data
